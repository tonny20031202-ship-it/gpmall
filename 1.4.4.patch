+	/**
+	 * 执行库存扣减 - 注意：移除了 @Transactional，直接在当前事务中执行
+	 */
+	private void executeSubStock(CreateOrderContext context) {
+		List<CartProductDto> cartProductDtoList = context.getCartProductDtoList();
+		List<Long> itemIds = new ArrayList<>();
+		for (CartProductDto dto : cartProductDtoList) {
+			itemIds.add(dto.getProductId());
+		}
+		itemIds.sort(Long::compareTo);
+
+		List<Stock> list = stockMapper.findStocksForUpdate(itemIds);
+		if (list == null || list.isEmpty()) {
+			throw new com.gpmall.commons.tool.exception.BizException("库存未初始化");
+		}
+		if (list.size() != itemIds.size()) {
+			throw new com.gpmall.commons.tool.exception.BizException("有商品未初始化库存");
+		}
+
+		for (Stock stock : list) {
+			for (CartProductDto one : cartProductDtoList) {
+				if (Objects.equals(one.getProductId(), stock.getItemId())) {
+					if (stock.getStockCount() < one.getProductNum()) {
+						throw new com.gpmall.commons.tool.exception.BizException(stock.getItemId() + "库存不足");
+					}
+					stock.setLockCount(one.getProductNum().intValue());
+					stock.setStockCount(-one.getProductNum());
+					stockMapper.updateStock(stock);
+					break;
+				}
+			}
+		}
+		context.setBuyProductIds(itemIds);
+	}
