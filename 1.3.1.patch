+    private SearchQueryContext buildSearchQuery(SearchRequest request) {
+        BoolQueryBuilder boolQueryBuilder = QueryBuilders.boolQuery();
+        boolean hasCondition = false;
+
+        String keyword = request == null ? null : StringUtils.trim(request.getKeyword());
+        if (StringUtils.isNotBlank(keyword)) {
+            boolQueryBuilder.must(QueryBuilders.matchQuery("title", keyword));
+            hasCondition = true;
+        }
+
+        Long categoryId = resolveCategoryId(request);
+        if (categoryId != null) {
+            boolQueryBuilder.filter(QueryBuilders.termQuery("cid", categoryId));
+            hasCondition = true;
+        }
+
+        RangeQueryBuilder priceRangeQuery = buildPriceRangeQuery(request == null ? null : request.getPriceGt(),
+                request == null ? null : request.getPriceLte());
+        if (priceRangeQuery != null) {
+            boolQueryBuilder.filter(priceRangeQuery);
+            hasCondition = true;
+        }
+
+        return new SearchQueryContext(boolQueryBuilder, hasCondition);
+    }
