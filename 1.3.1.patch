+    private Pageable buildPageable(SearchRequest request) {
+        int currentPage = request == null || request.getCurrentPage() == null || request.getCurrentPage() < 1
+                ? 1 : request.getCurrentPage();
+        int pageSize = request == null || request.getPageSize() == null || request.getPageSize() < 1
+                ? 20 : request.getPageSize();
+        Sort sort = buildSort(request == null ? null : request.getSort());
+        if (sort == null) {
+            return new PageRequest(currentPage - 1, pageSize);
