+    private RangeQueryBuilder buildPriceRangeQuery(Integer priceGt, Integer priceLte) {
+        if (priceGt == null && priceLte == null) {
+            return null;
+        }
+        RangeQueryBuilder rangeQueryBuilder = QueryBuilders.rangeQuery("price");
+        if (priceGt != null) {
+            rangeQueryBuilder.gt(priceGt);
+        }
+        if (priceLte != null) {
+            rangeQueryBuilder.lte(priceLte);
+        }
+        return rangeQueryBuilder;
+    }
