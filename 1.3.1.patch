+        Long categoryId = readLongValue(request, "getCid");
+        if (categoryId != null) {
+            return categoryId;
+        }
+        categoryId = readLongValue(request, "getCategoryId");
+        if (categoryId != null) {
+            return categoryId;
+        }
+        return readLongValue(request, "getCategory");
